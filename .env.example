# Copier en .env puis adapter. Le .env n'est jamais commité.

# UID des fichiers créés par Airflow (Linux : $(id -u) ; macOS : laisser 50000)
AIRFLOW_UID=50000

# Airflow — base de métadonnées
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Airflow — secrets (identiques pour tous les composants)
# Générer : python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_API_SECRET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me

# Airflow — compte admin UI (http://localhost:8080)
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Data Warehouse (hôte : localhost:5433 · conteneurs : postgres-dwh:5432)
DWH_USER=dwh_user
DWH_PASSWORD=dwh_password_2026
DWH_DB=dwh

# MinIO (console : http://localhost:9001)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_2026
MINIO_BUCKET=data-lake

# API Marketplace simulée (http://localhost:5000)
MARKETPLACE_API_TOKEN=formation-token-2026
API_ORDERS_PER_DAY=1000
# Probabilité de 503 simulé (tester le retry du Hook), 0 = jamais
API_FAILURE_RATE=0

# Metabase (http://localhost:3000) — compte admin créé par metabase/setup_dashboards.py
MB_ADMIN_EMAIL=admin@maelys.local
MB_ADMIN_PASSWORD=Admin2026!
